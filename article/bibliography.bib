@article{zhou2025meta,
	title = {A Meta-Reinforcement Learning-Based Poisoning Attack Framework Against Federated Learning},
	volume = {13},
	issn = {2169-3536},
	url = {https://ieeexplore.ieee.org/document/10872904},
	doi = {10.1109/ACCESS.2025.3538891},
	abstract = {Federated learning enables multiple clients to collaboratively train a global model without sharing raw data, but it remains vulnerable to poisoning attacks. This work proposes a meta-reinforcement-learning-based poisoning attack framework against federated learning. The method infers global client data distribution from global gradients, simulates the federated learning environment locally, and learns scaling and noise-injection strategies for poisoning model updates. The framework is evaluated under several aggregation strategies, including FedAvg, clipping, median, clipping-median, Krum, and trimmed mean.},
